# ==============================================================================
# Adversarial Arena Environment Configuration
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_NAME="Adversarial Arena Backend"
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Security & CORS
# Fernet 32-byte url-safe base64 key for encrypting provider API keys at rest.
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=2j8S9k_wwrYCfONyKkMNUmsik6l3Xm-uIWEkS6ENLjY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_RUNS_PER_MINUTE=10

# Clerk Authentication & Webhooks
# JWKS URL: https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=https://api.clerk.dev/v1/jwks
CLERK_ISSUER=https://clerk.your-domain.com
CLERK_AUDIENCE=
CLERK_WEBHOOK_SECRET=whsec_sample_secret_key_for_svix_testing

# PostgreSQL 16 (Async via asyncpg)
POSTGRES_USER=arena_user
POSTGRES_PASSWORD=arena_secure_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=adversarial_arena
DATABASE_URL=postgresql+asyncpg://arena_user:arena_secure_password@postgres:5432/adversarial_arena
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery Broker & Backend
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# LLM Providers (Optional / Fallback defaults)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Observability & Logging
LOG_LEVEL=INFO
LOG_JSON=true
REDACT_PROMPTS_IN_LOGS=true
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Storage for Reports & Artifacts
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/tmp/arena_reports
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
